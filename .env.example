# Only ONE env variable is required — the database connection string.
# All other secrets (Resend API key, sender address) are hardcoded in src/lib/email.ts
#
# For Vercel: set this in Project Settings → Environment Variables
# For local dev: copy this file to .env and fill in the value
#
# Get a free PostgreSQL database at:
#   - https://vercel.com/docs/storage/vercel-postgres (recommended — native Vercel integration)
#   - https://neon.tech (free tier, 0.5GB)
#   - https://supabase.com (free tier, 500MB)
#
# The connection string looks like:
#   postgresql://user:password@host:port/database?schema=public
DATABASE_URL="postgresql://user:password@host:port/database?schema=public"
