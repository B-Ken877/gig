generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  name          String
  role          String   @default("visitor")
  phone         String?
  avatar        String?
  isActive      Boolean  @default(true)
  accountStatus String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  agent   Agent?
  client  Client?
  conversationsAsUser1 Conversation[] @relation("ConvUser1")
  conversationsAsUser2 Conversation[] @relation("ConvUser2")
  auditLogs   AuditLog[]
  notifications Notification[]
  paymentRequestsHandled PaymentRequest[] @relation("PaymentTaker")
  paymentRequests PaymentRequest[]
  pushSubscription  PushSubscription?
  supportTickets   SupportTicket[]

  @@index([role])
  @@index([email])
}

model Agent {
  id              String   @id @default(cuid())
  userId          String   @unique
  status          String   @default("Available")
  country         String?
  address         String?
  dateOfBirth     DateTime?
  languages       String   @default("[]")
  experience      Int      @default(0)
  skills          String   @default("[]")
  previousEmployers String @default("[]")
  education       String   @default("[]")
  computerSpecs   String   @default("{}")
  ram             String?
  processor       String?
  internetSpeed   String?
  backupInternet  Boolean  @default(false)
  headsetAvailable Boolean @default(false)
  upsAvailable    Boolean  @default(false)
  preferredShift  String?
  salaryExpectation Float?
  niu             String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents       Document[]
  availabilitySlots AvailabilitySlot[]
  notes           InternalNote[]

  @@index([status])
  @@index([country])
}

model Client {
  id              String   @id @default(cuid())
  userId          String   @unique
  companyName     String
  industry        String?
  contactPerson   String?
  phone           String?
  billingAddress  String?
  billingEmail    String?
  taxId           String?
  companyLink     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPosts        JobPost[]
  callCenterNeeds CallCenterNeed[]
  notes           InternalNote[]

  @@index([industry])
}

model JobPost {
  id              String   @id @default(cuid())
  clientId        String?
  companyName     String
  companyLink     String?
  jobTitle        String
  description     String
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  client          Client?  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([isActive])
}

model CallCenterNeed {
  id              String   @id @default(cuid())
  clientId        String
  title           String
  description     String
  requirements    String   @default("[]")
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([isActive])
}

model PaymentRequest {
  id              String   @id @default(cuid())
  userId          String
  role            String
  feeType         String
  amount          Float
  currency        String   @default("HTG")
  status          String   @default("pending")
  handledBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  handledByUser   User?    @relation("PaymentTaker", fields: [handledBy], references: [id])

  @@index([status])
  @@index([userId])
}

model Document {
  id              String   @id @default(cuid())
  agentId         String
  type            String
  fileName        String
  fileUrl         String
  fileSize        Int?
  mimeType        String?
  version         Int      @default(1)
  downloadCount   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  agent           Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([type])
}

model Notification {
  id              String   @id @default(cuid())
  userId          String
  channel         String   @default("in-app")
  title           String
  message         String
  type            String?
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model InternalNote {
  id              String   @id @default(cuid())
  agentId         String?
  clientId        String?
  authorId        String
  type            String
  content         String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  agent           Agent?   @relation(fields: [agentId], references: [id])
  client          Client?  @relation(fields: [clientId], references: [id])
}

model AuditLog {
  id              String   @id @default(cuid())
  userId          String?
  action          String
  entity          String?
  entityId        String?
  details         String?
  ipAddress       String?
  createdAt       DateTime @default(now())
  user            User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
}

model AvailabilitySlot {
  id              String   @id @default(cuid())
  agentId         String
  date            String
  startTime       String?
  endTime         String?
  isAvailable     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  agent           Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model Conversation {
  id              String   @id @default(cuid())
  user1Id         String
  user2Id         String
  lastMessage     String?
  lastMessageAt   DateTime?
  unreadUser1     Int      @default(0)
  unreadUser2     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user1           User     @relation("ConvUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2           User     @relation("ConvUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  messages        Message[]

  @@unique([user1Id, user2Id])
}

model Message {
  id              String   @id @default(cuid())
  conversationId  String
  senderId        String
  senderRole      String?
  content         String
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([isRead])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String   @unique
  endpoint  String
  keys      String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
model SupportTicket {
  id              String   @id @default(cuid())
  userId          String
  subject         String
  description     String
  status          String   @default("open")
  conversationId  String?
  assignedTo      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([assignedTo])
}