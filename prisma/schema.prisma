generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================================================
// USER — only admin and agent roles exist in the new philosophy.
// (Legacy 'client' and 'payment_taker' rows are kept for backward compat
//  but no new ones can be created through the UI.)
// ============================================================================

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  password      String
  name          String
  role          String   @default("agent")
  phone         String?
  avatar        String?
  isActive      Boolean  @default(true)
  accountStatus String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  agent   Agent?
  conversationsAsUser1 Conversation[] @relation("ConvUser1")
  conversationsAsUser2 Conversation[] @relation("ConvUser2")
  auditLogs   AuditLog[]
  notifications Notification[]
  pushSubscription  PushSubscription?
  supportTickets   SupportTicket[]
  @@index([role])
  @@index([email])
}

model Agent {
  id              String   @id @default(cuid())
  userId          String   @unique
  status          String   @default("Available")
  country         String?
  address         String?
  dateOfBirth     DateTime?
  languages       String   @default("[]")
  experience      Int      @default(0)
  skills          String   @default("[]")
  previousEmployers String @default("[]")
  education       String   @default("[]")
  computerSpecs   String   @default("{}")
  ram             String?
  processor       String?
  internetSpeed   String?
  backupInternet  Boolean  @default(false)
  headsetAvailable Boolean @default(false)
  upsAvailable    Boolean  @default(false)
  preferredShift  String?
  salaryExpectation Float?
  niu             String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents       Document[]
  availabilitySlots AvailabilitySlot[]
  notes           InternalNote[]
  assessments     Assessment[]
  placements      Placement[]
  jobApplications JobApplication[]

  @@index([status])
  @@index([country])
}

// ============================================================================
// PROVIDER — internal-only. The public never sees this. The admin records
// which third-party gave us a job to post, plus the commission we earn.
// ============================================================================

model Provider {
  id              String   @id @default(cuid())
  name            String
  contactPerson   String?
  phone           String?
  email           String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  jobPosts        JobPost[]

  @@index([name])
}

// ============================================================================
// JOB POST — posted by the admin only. The admin assigns it to a Provider
// (internal record) and sets a commission. The public career page only sees
// the jobTitle, description, skills, hourlyRate, etc. — never the provider.
// ============================================================================

model JobPost {
  id              String   @id @default(cuid())
  jobTitle        String
  description     String
  skills          String   @default("[]")     // JSON array of strings
  requirements    String   @default("[]")     // JSON array of strings
  hourlyRate      Float    @default(0)
  payFrequency    String   @default("bi-weekly") // hourly | weekly | bi-weekly | monthly
  category        String?
  shift           String?
  location        String?  @default("Remote")
  providerId      String?
  commission      Float    @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  provider        Provider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  applications    JobApplication[]
  placements      Placement[]

  @@index([isActive])
  @@index([providerId])
  @@index([category])
}

// ============================================================================
// JOB APPLICATION — an agent applies for a JobPost. Before the application
// is created, the agent MUST pass a per-job Assessment. The unique constraint
// prevents duplicate applications for the same job.
// ============================================================================

model JobApplication {
  id              String   @id @default(cuid())
  agentId         String
  jobPostId       String
  status          String   @default("applied") // applied | reviewed | hired | rejected
  coverMessage    String?
  assessmentScore Float?
  assessmentPassed Boolean @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  agent           Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  jobPost         JobPost  @relation(fields: [jobPostId], references: [id], onDelete: Cascade)

  @@unique([agentId, jobPostId])
  @@index([agentId])
  @@index([jobPostId])
  @@index([status])
}

// ============================================================================
// PLACEMENT — when an agent is hired for a JobPost. This drives the agent's
// "My Work" view and the admin's placement management table. The salary and
// next salary date are defined by the admin.
// ============================================================================

model Placement {
  id              String   @id @default(cuid())
  agentId         String
  jobPostId       String
  position        String
  startDate       DateTime?
  endDate         DateTime?
  salary          Float?
  nextSalaryDate  DateTime?
  status          String   @default("active") // active | completed | terminated
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  agent           Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  jobPost         JobPost  @relation(fields: [jobPostId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([jobPostId])
  @@index([status])
}

// ============================================================================
// SALARY DATE — admin-defined pay schedule. Shown on agent dashboard so they
// know when the next payday is. Global (not per-job) for simplicity; the
// admin can mark which pay cycle each one belongs to via description.
// ============================================================================

model SalaryDate {
  id              String   @id @default(cuid())
  payDate         DateTime
  frequency       String   @default("bi-weekly")
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([payDate])
}

// ============================================================================
// ASSESSMENT — per-job. Created when an agent starts the assessment for a
// specific JobPost. Passed assessments unlock the apply button.
// ============================================================================

model Assessment {
  id              String   @id @default(cuid())
  agentId         String
  jobPostId       String?
  section         String   @default("general")
  totalQuestions  Int      @default(0)
  correctAnswers  Int      @default(0)
  score           Float    @default(0)
  passed          Boolean  @default(false)
  answers         String   @default("[]")
  completedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  agent           Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([jobPostId])
  @@index([section])
}

model Document {
  id              String   @id @default(cuid())
  agentId         String
  type            String
  fileName        String
  fileUrl         String
  fileSize        Int?
  mimeType        String?
  version         Int      @default(1)
  downloadCount   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  agent           Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([type])
}

model Notification {
  id              String   @id @default(cuid())
  userId          String
  channel         String   @default("in-app")
  title           String
  message         String
  type            String?
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
}

model InternalNote {
  id              String   @id @default(cuid())
  agentId         String?
  authorId        String
  type            String
  content         String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  agent           Agent?   @relation(fields: [agentId], references: [id])
}

model AuditLog {
  id              String   @id @default(cuid())
  userId          String?
  action          String
  entity          String?
  entityId        String?
  details         String?
  ipAddress       String?
  createdAt       DateTime @default(now())
  user            User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
}

model AvailabilitySlot {
  id              String   @id @default(cuid())
  agentId         String
  date            String
  startTime       String?
  endTime         String?
  isAvailable     Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  agent           Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model Conversation {
  id              String   @id @default(cuid())
  user1Id         String
  user2Id         String
  lastMessage     String?
  lastMessageAt   DateTime?
  unreadUser1     Int      @default(0)
  unreadUser2     Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user1           User     @relation("ConvUser1", fields: [user1Id], references: [id], onDelete: Cascade)
  user2           User     @relation("ConvUser2", fields: [user2Id], references: [id], onDelete: Cascade)
  messages        Message[]

  @@unique([user1Id, user2Id])
}

model Message {
  id              String   @id @default(cuid())
  conversationId  String
  senderId        String
  senderRole      String?
  content         String
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([isRead])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String   @unique
  endpoint  String
  keys      String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SupportTicket {
  id              String   @id @default(cuid())
  userId          String
  subject         String
  description     String
  status          String   @default("open")
  assignedTo      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages        TicketMessage[]

  @@index([userId])
  @@index([status])
  @@index([assignedTo])
}

model TicketMessage {
  id              String   @id @default(cuid())
  ticketId        String
  senderId        String
  senderRole      String
  content         String
  createdAt       DateTime @default(now())

  ticket          SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([createdAt])
}
